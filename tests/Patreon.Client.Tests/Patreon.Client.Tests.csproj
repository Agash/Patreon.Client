<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- IDE0005 cannot run without GenerateDocumentationFile, which tests do not produce;
         Roslyn errors asking for it rather than staying silent. CA1707/IDE1006 cover test naming,
         CA1515 fires only because OutputType=Exe, CA2007 is noise in test bodies. -->
    <NoWarn>$(NoWarn);IDE0005;IDE1006;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Patreon.Client\Patreon.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
